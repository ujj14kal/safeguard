# Safeguard backend configuration template.
# Copy to .env and fill in locally. NEVER commit .env — all values here are EMPTY.
# All keys come from environment variables; nothing secret lives in code.

# Meta Model API (Muse) — see https://dev.meta.ai/docs for exact API details
META_MODEL_API_BASE_URL=
META_MODEL_API_KEY=
MUSE_MODEL=

# Meta SAM 2 (backend, local checkpoint path)
SAM2_CHECKPOINT_PATH=
# Per-clip SAM 2 budget in seconds (default: 3; over budget falls back to Muse-only)
SAM2_MAX_LATENCY_S=

# Backend /verify behaviour
VERIFY_THRESHOLD=
# Max Muse calls per minute (default: 20)
VERIFY_RATE_LIMIT_PER_MIN=

# Twilio (backend only; verified test numbers only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Incident / streaming
# Incident link TTL in hours (default: 2)
INCIDENT_TOKEN_TTL_HOURS=
# Persist evidence frames server-side (default: false — memory only)
EVIDENCE_RECORDING=
STREAM_INGEST_URL=

# Public URL of backend (printed by the tunnel script)
BACKEND_PUBLIC_URL=

# Code phrases (close variants accepted; defaults set in app config)
CODE_PHRASE_SAFE=
CODE_PHRASE_UNSAFE=
