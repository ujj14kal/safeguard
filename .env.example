# Safeguard backend configuration template.
# Copy to .env and fill in locally. NEVER commit .env — all values here are EMPTY.
# All keys come from environment variables; nothing secret lives in code.

# Meta Model API (Muse) — see https://dev.meta.ai/docs for exact API details
# Base URL default: https://api.meta.ai/v1 (docs). Auth: bearer token from key below.
META_MODEL_API_BASE_URL=
META_MODEL_API_KEY=
# Model default: muse-spark-1.3 (docs: Spark flagship, standard mode).
MUSE_MODEL=
# Per-call Muse HTTP timeout in seconds (default: 20).
MUSE_TIMEOUT_S=

# Meta SAM 2 (backend, local checkpoint path)
SAM2_CHECKPOINT_PATH=
# SAM 2 mode: auto (try, fall back when slow/missing), sam2 (require),
# muse-only (never try). Default set by the Phase 4 spike — see DECISIONS.md.
SAM2_MODE=
# SAM 2 model config (default: configs/sam2.1/sam2.1_hiera_t.yaml).
SAM2_CONFIG=
# Per-clip SAM 2 budget in seconds (default: 3; over budget falls back to Muse-only)
SAM2_MAX_LATENCY_S=
# Seconds to skip SAM 2 after a slow/failed attempt (default: 600).
SAM2_RETRY_AFTER_S=

# Backend /verify behaviour
VERIFY_THRESHOLD=
# Max Muse calls per minute (default: 20)
VERIFY_RATE_LIMIT_PER_MIN=
# Corridor half-width for SAM 2 geometry (must match app default 0.18).
VERIFY_CORRIDOR_HALF_WIDTH=
# JSONL verify-call log (default: logs/verify.jsonl, gitignored).
VERIFY_LOG_PATH=

# Twilio (backend only; verified test numbers only)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Incident / streaming
# Incident link TTL in hours (default: 2)
INCIDENT_TOKEN_TTL_HOURS=
# Persist evidence frames server-side (default: false — memory only)
EVIDENCE_RECORDING=
STREAM_INGEST_URL=

# Public URL of backend (printed by the tunnel script)
BACKEND_PUBLIC_URL=

# Code phrases (close variants accepted; defaults set in app config)
CODE_PHRASE_SAFE=
CODE_PHRASE_UNSAFE=
