    "This cannot be undone. Contacts, history, recordings, settings and backend evidence are all deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Contacts, history, recordings, settings and backend evidence are all deleted."
