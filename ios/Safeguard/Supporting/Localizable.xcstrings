        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकएंड चलाने वाला Mac, उसी Wi-Fi पर। बिल्ड-टाइम URL के लिए खाली छोड़ें। 127.0.0.1 सिर्फ़ Simulator में चलता है।"
