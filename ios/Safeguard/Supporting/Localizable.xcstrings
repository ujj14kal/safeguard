        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैमरे के बिना Safeguard खतरों पर नज़र नहीं रख सकता।"
          }
        }
      }
    },
    "Without the microphone, voice answers and distress words will not work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the microphone, voice answers and distress words will not work."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन के बिना आवाज़ वाले जवाब और परेशानी के शब्द काम नहीं करेंगे।"
          }
        }
      }
    },
    "Words like “help” and “bachao” start a 5-second auto-SOS countdown you can cancel. On-device, always.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words like “help” and “bachao” start a 5-second auto-SOS countdown you can cancel. On-device, always."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "“help” और “bachao” जैसे शब्द 5 सेकंड की ऑटो-SOS उलटी गिनती शुरू करते हैं जिसे आप रद्द कर सकते हैं। हमेशा ऑन-डिवाइस।"
          }
        }
      }
    },
