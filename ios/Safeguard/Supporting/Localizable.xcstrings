    "Couldn't reach the backend, so there is no exact text to show. The real SOS retries automatically when offline.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the backend, so there is no exact text to show. The real SOS retries automatically when offline."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकएंड से संपर्क नहीं हो सका, इसलिए सही टेक्स्ट दिख नहीं सकता। असली SOS ऑफ़लाइन होने पर अपने-आप फिर कोशिश करता है।"
          }
        }
