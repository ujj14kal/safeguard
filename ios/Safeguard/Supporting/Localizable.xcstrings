          }
        }
      }
    },
    "This person agreed to be alerted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This person agreed to be alerted"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह व्यक्ति अलर्ट पाने के लिए राज़ी है"
          }
        }
      }
    },
    "This runs a SAMPLE SOS: no real message, no recording, no location sent. You will see the red screen, the four track chips and exactly the text your contacts would receive.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runs a SAMPLE SOS: no real message, no recording, no location sent. You will see the red screen, the four track chips and exactly the text your contacts would receive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह एक नमूना SOS है: कोई असली संदेश नहीं, कोई रिकॉर्डिंग नहीं, कोई लोकेशन नहीं भेजी जाती। आपको लाल स्क्रीन, चारों ट्रैक चिप और वही टेक्स्ट दिखेगा जो आपके संपर्कों को मिलेगा।"
          }
        }
      }
    },
    "This setup takes about 3 minutes.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This setup takes about 3 minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सेटअप में लगभग 3 मिनट लगते हैं।"
          }
        }
      }
    },
    "Threatening words": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Threatening words"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धमकी भरे शब्द"
          }
        }
      }
    },
    "To hear your answers, distress words and shouting.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To hear your answers, distress words and shouting."
          }
