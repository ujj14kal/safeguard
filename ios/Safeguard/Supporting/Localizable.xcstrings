    "A code phrase cannot be a distress word.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A code phrase cannot be a distress word."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कोड वाक्य परेशानी का शब्द नहीं हो सकता।"
          }
        }
      }
    },
    "A distress word starts a 5-second countdown you can cancel. No reply to the spoken check-in within 10 seconds starts an SOS.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A distress word starts a 5-second countdown you can cancel. No reply to the spoken check-in within 10 seconds starts an SOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई परेशानी का शब्द 5 सेकंड की उलटी गिनती शुरू करता है जिसे आप रद्द कर सकते हैं। बोले गए सवाल का 10 सेकंड में जवाब न मिलने पर SOS शुरू हो जाता है।"
          }
        }
      }
    },
    "A few permissions": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A few permissions"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ अनुमतियाँ"
          }
        }
      }
    },
    "A safe phrase answers “I'm OK”. An unsafe phrase starts an SOS at once — even mid-sentence, even with everything off.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A safe phrase answers “I'm OK”. An unsafe phrase starts an SOS at once — even mid-sentence, even with everything off."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेफ वाक्य “मैं ठीक हूँ” का जवाब देता है। अनसेफ वाक्य तुरंत SOS शुरू करता है — बीच वाक्य में भी, सब कुछ बंद होने पर भी।"
          }
        }
      }
    },
