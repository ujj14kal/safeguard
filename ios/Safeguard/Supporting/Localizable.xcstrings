    "Wipes contacts, history, saved recordings and settings on this phone, and asks the backend to delete your evidence and contacts. Setup will restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wipes contacts, history, saved recordings and settings on this phone, and asks the backend to delete your evidence and contacts. Setup will restart."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस फ़ोन पर संपर्क, इतिहास, सहेजी गई रिकॉर्डिंग और सेटिंग मिटाता है, और बैकएंड से आपका सबूत और संपर्क हटाने को कहता है। सेटअप फिर से शुरू होगा।"
          }
        }
      }
    },
    "Without location, the SOS route and live location will not work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without location, the SOS route and live location will not work."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लोकेशन के बिना SOS रास्ता और लाइव लोकेशन काम नहीं करेंगे।"
          }
        }
      }
    },
    "Without speech recognition, voice features will not work.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without speech recognition, voice features will not work."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पीच पहचान के बिना आवाज़ वाली सुविधाएँ काम नहीं करेंगी।"
          }
        }
      }
    },
    "Without the camera, Safeguard cannot watch for threats.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the camera, Safeguard cannot watch for threats."
