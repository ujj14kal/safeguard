        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह वापस नहीं होगा। संपर्क, इतिहास, रिकॉर्डिंग, सेटिंग और बैकएंड सबूत सब हट जाएँगे।"
          }
        }
      }
    },
    "This cannot be undone. Only this phone's history is deleted.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This cannot be undone. Only this phone's history is deleted."
          }
