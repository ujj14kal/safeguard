    "Add at least 2 people who agreed to be alerted. A contact receives alerts ONLY after they open the invite link and press Start in Telegram.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add at least 2 people who agreed to be alerted. A contact receives alerts ONLY after they open the invite link and press Start in Telegram."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम 2 ऐसे लोग जोड़ें जो अलर्ट पाने के लिए राज़ी हों। कोई संपर्क तभी अलर्ट पाएगा जब वह इनवाइट लिंक खोलेगा और Telegram में Start दबाएगा।"
          }
        }
