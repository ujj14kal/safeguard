        }
      }
    },
    "Safeguard cannot call the police for you.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard cannot call the police for you."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard आपके लिए पुलिस को कॉल नहीं कर सकता।"
          }
        }
      }
    },
    "Safeguard needs to read your contacts so you can choose who to alert. It only reads names and numbers, keeps your choices on this phone, and never uploads your address book.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard needs to read your contacts so you can choose who to alert. It only reads names and numbers, keeps your choices on this phone, and never uploads your address book."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किसे सूचित करना चाहते हैं यह चुनने के लिए Safeguard को आपके संपर्क पढ़ने होंगे। यह सिर्फ़ नाम और नंबर पढ़ता है, आपकी पसंद इसी फ़ोन में रखता है और आपकी एड्रेस बुक कभी अपलोड नहीं करता।"
          }
        }
      }
    },
    "Safeguard never dials by itself. Everything else in an SOS runs automatically.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard never dials by itself. Everything else in an SOS runs automatically."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard कभी अपने-आप कॉल नहीं करता। SOS में बाकी सब अपने-आप चलता है।"
          }
        }
      }
    },
    "Safeguard server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard server"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard सर्वर"
          }
        }
      }
    },
    "Safeguard stores your name, email, optional phone and language in your account. Your password goes straight to the sign-in service and is never stored by Safeguard. Contacts you pick stay on this phone. You can delete your account any time in Settings.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard stores your name, email, optional phone and language in your account. Your password goes straight to the sign-in service and is never stored by Safeguard. Contacts you pick stay on this phone. You can delete your account any time in Settings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard आपके खाते में आपका नाम, ईमेल, वैकल्पिक फ़ोन और भाषा रखता है। आपका पासवर्ड सीधे साइन-इन सेवा के पास जाता है और Safeguard उसे कभी नहीं रखता। आपके चुने संपर्क इसी फ़ोन में रहते हैं। आप कभी भी सेटिंग में अपना खाता हटा सकते हैं।"
          }
        }
      }
    },
    "Safeguard watches for threatening behaviour by people nearby.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard watches for threatening behaviour by people nearby."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard आस-पास के लोगों के खतरनाक बर्ताव पर नज़र रखता है।"
          }
        }
      }
    },
    "Safeguard watches for threatening behaviour — never appearance or identity. Transcripts stay on this phone unless you switch on a cloud helper; cloud features send data to your own Safeguard backend and on to Meta's models.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard watches for threatening behaviour — never appearance or identity. Transcripts stay on this phone unless you switch on a cloud helper; cloud features send data to your own Safeguard backend and on to Meta's models."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard खतरनाक बर्ताव पर नज़र रखता है — कभी रूप या पहचान पर नहीं। बातचीत का पाठ इस फ़ोन पर ही रहता है जब तक आप क्लाउड सहायक चालू न करें; क्लाउड सुविधाएँ आपका डेटा आपके अपने Safeguard बैकएंड और आगे Meta के मॉडलों को भेजती हैं।"
          }
        }
      }
    },
    "Safeguard, stop • status • dim": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safeguard, stop • status • dim"
          }
